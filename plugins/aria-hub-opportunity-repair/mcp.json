{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "aria-hub-repair": {
      "type": "streamable-http",
      "url": "https://www.myariahub.com/mcp/repair",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "resource": "https://www.myariahub.com/mcp/repair",
            "defaultScopes": ["aria.repair.read", "aria.repair.write"]
          }
        }
      }
    }
  }
}
