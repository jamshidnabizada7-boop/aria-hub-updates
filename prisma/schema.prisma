  items       GalleryItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model GalleryItem {
  id          String        @id @default(cuid())
  title       String
  type        String        @default("image") // image | video
  url         String
  thumbnail   String?
  caption     String?
  captionI18n Json?
  category    String? // Office | Events | Travel | Team | etc.
  albumId     String?
  album       GalleryAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([albumId])
  @@index([category])
}

