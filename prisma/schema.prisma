  content     String
  contentI18n Json?
  featured    Boolean  @default(false)
  status      String   @default("published")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([featured])
  @@index([status])
}

// ─── Partners ────────────────────────────────────────────────────────────────
model Partner {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  website   String?
  order     Int      @default(0)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

