// ARIA HUB — Professional Business Services Platform
// Fully dynamic, CMS-driven relational schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Status enums (converted from free-text strings, Phase 2) ───────────────
// Values match every status observed in the database and written by the app.

enum OpportunityStatus {
  published
  draft
  expired
  archived
}

enum ImportRunStatus {
  running
  pending
  ok
  partial
  error
  stopped
}

enum MonetizationOrderStatus {
  requested
  payment_claimed
  paid
  active
  delivered
  declined
}

// ─── Site-wide settings (single row, key/value style + structured) ───────────
model SiteSetting {
  id                 String   @id @default(cuid())
  siteName           String   @default("ARIA HUB")
  siteNameI18n       Json?
  tagline            String   @default("Professional Business Services Platform")
  taglineI18n        Json?
  description        String   @default("Premium business, visa and opportunity services.")
  descriptionI18n    Json?
  logoUrl            String?
  logoDarkUrl        String?
  faviconUrl         String?
  appleIconUrl       String?
  primaryColor       String   @default("#0A66C2")
  secondaryColor     String   @default("#0EA5E9")
  accentColor        String   @default("#22D3EE")
  fontFamily         String   @default("Geist")
  email              String?
  phone              String?
  address            String?
  addressI18n        Json?
  currency           String   @default("USD")
  timezone           String   @default("Asia/Karachi")
  dateFormat         String   @default("MMM dd, yyyy")
  maintenanceMode    Boolean  @default(false)
  gaId               String?
  fbPixelId          String?
  customScripts      String?
  mapEmbed           String?
  socialPosition     String   @default("left") // left | right
  socialHideOnScroll Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─── Languages ───────────────────────────────────────────────────────────────
model Language {
  id           String   @id @default(cuid())
  code         String   @unique // en, fa, ps
  name         String // English, Persian, Pashto
  nativeName   String // English, فارسی, پښتو
  direction    String   @default("ltr") // ltr | rtl
  enabled      Boolean  @default(true)
  isDefault    Boolean  @default(false)
  flag         String?
  order        Int      @default(0)
  translations Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Navigation menus (unlimited nested) ─────────────────────────────────────
model MenuItem {
  id           String     @id @default(cuid())
  label        String
  labelI18n    Json? // { en: "...", fa: "...", ps: "..." }
  url          String?
  parentId     String?
  icon         String?
  order        Int        @default(0)
  visible      Boolean    @default(true)
  openInNewTab Boolean    @default(false)
  pageSlug     String?
  parent       MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[] @relation("MenuTree")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([parentId])
  @@index([order])
}

// ─── Page sections (CMS) ─────────────────────────────────────────────────────
model Section {
  id        String   @id @default(cuid())
  key       String   @unique // hero, services, whyChooseUs, etc.
  title     String
  subtitle  String?
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  config    String? // JSON string of section config
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Services ────────────────────────────────────────────────────────────────
model ServiceCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  icon        String?
  description String?
  order       Int       @default(0)
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Service {
  id              String           @id @default(cuid())
  title           String
  titleI18n       Json? // { en: "...", fa: "...", ps: "..." }
  slug            String           @unique
  excerpt         String
  excerptI18n     Json?
  description     String
  descriptionI18n Json?
  icon            String?
  image           String?
  gallery         String? // JSON array of image urls
  video           String?
  price           String?
  featured        Boolean          @default(false)
  status          String           @default("published") // published | draft | archived
  sort            Int              @default(0)
  seoTitle        String?
  seoDescription  String?
  categoryId      String?
  category        ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([categoryId])
  @@index([featured])
  @@index([status])
}

// ─── Visas ───────────────────────────────────────────────────────────────────
model Visa {
  id                     String   @id @default(cuid())
  country                String
  countryI18n            Json?
  countryCode            String?
  visaType               String
  visaTypeI18n           Json?
  slug                   String   @unique
  duration               String?
  processingTime         String?
  fee                    String?
  requirements           String? // JSON array
  requirementsI18n       Json?
  documents              String? // JSON array
  documentsI18n          Json?
  eligibility            String?
  eligibilityI18n        Json?
  embassyDetails         String?
  applicationProcess     String?
  applicationProcessI18n Json?
  faqs                   String? // JSON array
  image                  String?
  gallery                String? // JSON
  featured               Boolean  @default(false)
  status                 String   @default("published")
  sort                   Int      @default(0)
  seoTitle               String?
  seoDescription         String?
  description            String?
  descriptionI18n        Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([featured])
  @@index([status])
  @@index([country])
}

// ─── Opportunities (jobs, scholarships, etc.) ────────────────────────────────
model MatcherFeedback {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  signal        String
  intent        String?
  lang          String?
  createdAt     DateTime    @default(now())

  @@index([opportunityId, createdAt])
  @@index([signal, createdAt])
}

model OpportunityMatchProfile {
  id                 String      @id @default(cuid())
  opportunityId      String      @unique
  opportunity        Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  eligibleNationalities Json?
  eligibleCountries  Json?
  educationLevels    Json?
  fieldAreas         Json?
  minAge             Int?
  maxAge             Int?
  minExperienceYears Int?
  languages          Json?
  fundingType        String?
  locationType       String?
  visaSponsorship    Boolean?
  provenance         Json?
  confidence         Json?
  extractionVersion  String      @default("v1")
  reviewed           Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([reviewed])
  @@index([fundingType])
  @@index([locationType])
}

model OpportunityCategory {
  id            String        @id @default(cuid())
  name          String
  nameI18n      Json? // { en: "...", fa: "...", ps: "..." }
  slug          String        @unique
  icon          String?
  order         Int           @default(0)
  opportunities Opportunity[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ─── Canonical organizations (first-class employers / publishers) ────────────
// Slug convention: deterministic safe slug ("Norwegian Refugee Council" →
// "norwegian-refugee-council", "UNICEF" → "unicef"); never renamed casually.
// officialDomains: JSON array of canonical domains, e.g.
//   ["unicef.org", "jobs.unicef.org"] — used later for apply-URL verification.
// organizationType: ngo | un_agency | government | university | company |
//   embassy | scholarship_provider | other (free string until hardened).
// Backfill happens in a later phase — creation is deliberate, never automatic.
model Organization {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  nameI18n           Json? // { en: "...", fa: "...", ps: "..." }

  logoUrl            String?
  website            String?
  careersUrl         String?

  country            String?
  organizationType   String?

  description        String?
  descriptionI18n    Json?

  officialDomains    Json?

  verified           Boolean       @default(false)
  verificationMethod String? // how verified: official_email | manual_review | website_meta | ...
  verifiedAt         DateTime?

  active             Boolean       @default(true)

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  aliases            OrganizationAlias[]
  opportunities      Opportunity[]
}

// ─── Controlled organization name aliases ────────────────────────────────────
// `normalized` is the conservative matching key (see
// src/lib/organizations/normalize.ts) and is globally unique: one normalized
// alias resolves to exactly one organization. Merges happen ONLY through an
// explicit alias row — never through fuzzy name similarity. Examples:
//   IRC → International Rescue Committee      (curated)
//   UNICEF → United Nations Children's Fund   (curated / parenthetical)
model OrganizationAlias {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alias          String // verbatim alias as written in source data
  normalized     String       @unique
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Opportunity {
  id              String               @id @default(cuid())
  title           String
  titleI18n       Json?
  slug            String               @unique
  organization    String? // free-text display fallback; canonical link is organizationRef
  organizationId  String? // FK to Organization — nullable, set only when the org is resolved
  organizationRef Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  country         String?
  deadline        DateTime?
  description     String
  descriptionI18n Json?
  eligibility     String?
  eligibilityI18n Json?
  benefits        String?
  benefitsI18n    Json?
  website         String?
  applyUrl        String?
  applyUrlType    String? // application_email | application_form | direct_application | source_article_fallback | unknown
  locations       OpportunityLocation[]
  image           String?
  attachments     String? // JSON
  featured        Boolean              @default(false)
  status          OpportunityStatus    @default(published)
  sort            Int                  @default(0)
  seoTitle        String?
  seoDescription  String?
  categoryId      String?
  category        OpportunityCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  matchProfile    OpportunityMatchProfile?
  matcherFeedback MatcherFeedback[]
  monetizationOrders MonetizationOrder[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // ─── Automated import tracking (all optional; populated by import pipeline) ──
  sourceName           String?
  sourceUrl            String? @unique // canonical listing URL on source site
  originalUrl          String? // deep link to the original post
  importedAt           DateTime?
  lastChecked          DateTime?
  contentHash          String? // sha256 of normalized content for change detection
  aiSummary            String?
  aiSummaryI18n        Json?
  jobType              String? // job | scholarship | fellowship | internship | ...
  jobTypeI18n          Json?
  salary               String?
  salaryI18n           Json?
  educationReq         String?
  educationReqI18n     Json?
  experience           String?
  experienceI18n       Json?
  responsibilities     String?
  responsibilitiesI18n Json?
  requirements         String? // required documents / materials
  requirementsI18n     Json?
  guidelines           String? // submission guidelines / how to apply
  guidelinesI18n       Json?
  tags                 String? // JSON array of strings
  tagsI18n             Json? // { en: [...], fa: [...], ps: [...] }
  seoTitleI18n         Json?
  seoDescriptionI18n   Json?
  seoKeywords          String? // JSON array of strings
  seoKeywordsI18n      Json?
  ogTitle              String?
  ogTitleI18n          Json?
  ogDescription        String?
  ogDescriptionI18n    Json?
  canonicalUrl         String?
  importStatus         String? // imported | updated | skipped | failed | pending
  translationStatus    String? // pending | partial | complete | failed (legacy, recomputed from fa/ps states)
  faStatus             String? // pending | processing | complete | failed — Persian gate
  psStatus             String? // pending | processing | complete | failed — never started before faStatus === 'complete'
  translationSourceHash String? // sha256 of all translated source fields; mismatch ⇒ statuses reset
  translationProgress  Json? // { fa: {done,total,failed,attempts,updatedAt}, ps: {...} } observability
  language             String? // original source language code (en, fa, ps, ...)
  logoUrl              String?
  publishedDate        String?
  extractedData        Json? // store extra dynamic metadata scraped from the source
  extractedDataI18n    Json? // localized dynamic metadata scraped from the source

  @@index([categoryId])
  @@index([organizationId])
  @@index([featured])
  @@index([status])
  @@index([sourceUrl])
  @@index([contentHash])
  @@index([importStatus])
  @@index([deadline])
  @@index([createdAt])
  @@index([faStatus])
  @@index([psStatus])
}

// ─── Structured opportunity locations (one-to-many; multi-province = rows) ───
model OpportunityLocation {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  country       String? // canonical country, e.g. "Afghanistan"
  countryCode   String? // ISO-3166 alpha-2, e.g. "AF"
  province      String? // canonical admin-1, e.g. "Kabul" (34-province whitelist)
  city          String?
  district      String?
  rawLabel      String? // verbatim source string, for auditability
  source        String? // scraper | detail | backfill-extractedData | backfill-description | inferred | admin
  confidence    Float? // 1.0 deterministic … 0.5 whitelist-inferred
  createdAt     DateTime    @default(now())

  @@unique([opportunityId, province, city, district, rawLabel])
  @@index([opportunityId])
  @@index([province])
  @@index([country])
}

// ─── Translation chunk staging (atomic per-language commits) ─────────────────
// Every source chunk of every translatable field is staged here. A language's
// public i18n fields are committed ONLY when 100% of its chunks succeeded —
// a failed chunk can never silently vanish from a published translation.
model TranslationChunk {
  id        String   @id @default(cuid())
  ownerType String // opportunity | news
  ownerId   String
  lang      String // fa | ps (one language per chunk row — Persian-first gating)
  fieldKey  String // title | description | summary | eligibility | benefits | ...
  chunkIndex Int
  chunkTotal Int
  chunkHash String // sha256 of the source chunk text; mismatch ⇒ re-translate
  status    String   @default("pending") // pending | done | failed
  result    String? // translated text when status = done
  attempts  Int      @default(0)
  error     String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([ownerType, ownerId, lang, fieldKey, chunkIndex])
  @@index([ownerType, ownerId, lang, status])
  @@index([status, updatedAt])
}

// ─── Automated import sources ────────────────────────────────────────────────
model ImportSource {
  id              String      @id @default(cuid())
  name            String      @unique // "Wazifaha Jobs", "Scholarships.af"
  type            String // job | scholarship
  scraperKey      String // maps to a BaseScraper subclass in the registry
  baseUrl         String
  enabled         Boolean     @default(true)
  autoPublish     Boolean     @default(false) // publish immediately, else save as draft
  scheduleMinutes Int         @default(60) // informational; runs are admin-triggered
  defaultCategory String? // opportunity category slug hint
  config          String? // JSON: selectors, filters, API options, etc.
  lastRunAt       DateTime?
  lastRunStatus   String? // ok | error | partial
  lastRunStats    String? // JSON summary of last run
  runs            ImportRun[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// ─── Import run logs (one row per import execution) ──────────────────────────
model ImportRun {
  id           String       @id @default(cuid())
  sourceId     String
  source       ImportSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  startedAt    DateTime     @default(now())
  finishedAt   DateTime?
  status       ImportRunStatus @default(running) // running | pending | ok | error | partial | stopped
  found        Int          @default(0)
  imported     Int          @default(0)
  updated      Int          @default(0)
  skipped      Int          @default(0)
  duplicates   Int          @default(0)
  failed       Int          @default(0)
  processingMs Int          @default(0)
  errors       String? // JSON array of { url, message, ts }
  triggeredBy  String? // manual | <source-name>
  createdAt    DateTime     @default(now())

  @@index([sourceId])
  @@index([startedAt])
}

// ─── Gallery ─────────────────────────────────────────────────────────────────
model GalleryAlbum {
  id          String        @id @default(cuid())
  title       String
