  content         String
  contentI18n     Json?
  rating          Int      @default(5) // Difficulty rating 1-5
  status          String   @default("pending") // pending | published | rejected
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

// ─── Visa Interview Preparation Center ────────────────────────────────────────

