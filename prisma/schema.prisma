  contentI18n  Json?
  authorAlias  String?
  contactEmail String?
  featured     Boolean  @default(false)
  likes        Int      @default(0)
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

