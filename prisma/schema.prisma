  questionI18n      Json?
  categoryId        String?
  category          InterviewCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  difficulty        String             @default("medium") // beginner | medium | hard
  filters           Json?              // { scholarship: "...", university: "...", country: "...", degree: "..." }
  sampleAnswer      String?
  sampleAnswerI18n  Json?
  strongExample     String?
  strongExampleI18n Json?
  weakExample       String?
  weakExampleI18n   Json?
