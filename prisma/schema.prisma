  updatedAt   DateTime @updatedAt

  @@index([status])
}

// ─── Newsletter subscribers ──────────────────────────────────────────────────
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  status    String   @default("active") // active | unsubscribed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Community-submitted opportunities (moderation queue) ───────────────────
model OpportunitySubmission {
  id           String    @id @default(cuid())
  title        String
  organization String?
  categorySlug String // jobs | scholarships | internships | ...
  country      String?
  deadline     DateTime?
  applyUrl     String?
  applyEmail   String?
  description   String
  contactName  String?
  contactEmail String // for moderation follow-up
  status       String    @default("pending") // pending | approved | rejected
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedBy   String?
  sourceIp     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // ─── Employer lane (distinct from community submissions) ──
  submitterType  String  @default("community") // community | employer
  jobType        String? // full-time | part-time | contract | internship | remote
  salaryRange    String? // free text, e.g. "600–900 USD/month"
  location       String? // city / province, e.g. "Kabul"
  companyWebsite String? // https://…

  // ─── Submitter tracking & decision notifications ──
  referenceCode String    @unique // human-friendly tracking code, e.g. AR-7K2M9QCX
  lang          String    @default("en") // language the submitter used — drives notification email
  publishedSlug String? // set on approve → deep link for the /track page + notification email
  notifiedAt    DateTime? // when the decision email was sent (prevents double sends)

  @@index([status, createdAt])
}

// ─── Monetization Orders (paid postings & promotions — Phase-2 revenue) ──────
// Self-serve order funnel adapted to Afghanistan payment reality: buyer requests a
// product → pays via hawala/AfPay/hesabPay/bank/cash (or Payoneer/Wise for
// internationals) → claims payment with a reference → admin verifies → the
// platform auto-delivers (features the listing, schedules the sponsored slot).
model MonetizationOrder {
  id            String    @id @default(cuid())
  referenceCode String    @unique // human-friendly, e.g. AR-AD-7K2M9Q
  product       String // key from src/lib/monetization.ts PRODUCT_CATALOG
  status        MonetizationOrderStatus @default(requested)
  amountUsd     Float // quoted price in USD (server-side catalog price)
  amountAfn     Float // quoted AFN equivalent at order time (informational)
  buyerName     String
  buyerOrg      String?
  buyerEmail    String // follow-up + verification channel
  buyerPhone    String? // Afghan reality: phone/WhatsApp-first communication
  buyerLang     String    @default("fa") // language of the order form used
  message       String? // free-text requirements (job details, slot copy…)
  opportunityId String? // attached listing (featured/promotion orders)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  paymentMethod String? // hawala | afg_pay | hesab_pay | bank | cash | payoneer | wise | other
  paymentRef    String? // hawala code / transaction id provided by the buyer
  paidAt        DateTime?
  verifiedAt    DateTime?
  verifiedBy    String?
  deliveredAt   DateTime?
  featuredUntil DateTime? // set when auto-applied to the attached opportunity
  adminNote     String?
  sourceIp      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
}

// ─── Opportunity Email Alerts (lead capture until SMTP is configured) ───────
model AlertSubscriber {
  id           String    @id @default(cuid())
  email        String    @unique
  lang         String    @default("fa") // en | fa | ps — preferred digest language
  categorySlug String? // null = all categories
  frequency    String    @default("weekly") // weekly | daily
  status       String    @default("pending") // pending | active | unsubscribed
  confirmToken String? // reserved for double opt-in once email delivery is live
  sourceIp     String?
  lastDigestAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
}

/// Separate from category alerts: one opt-in saved Opportunity Matcher profile
/// per email address. The profile contains canonical non-display identifiers
/// only and is activated by double opt-in before any personalized digest.
model MatcherAlertSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  lang         String   @default("fa")
  profile      Json
  frequency    String   @default("daily")
  status       String   @default("pending")
  confirmToken String?
  sourceIp     String?
  lastDigestAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

