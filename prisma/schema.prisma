  label     String
  url       String
  icon      String?
  color     String?
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Footer ──────────────────────────────────────────────────────────────────
