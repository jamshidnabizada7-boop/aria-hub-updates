// ─── Brand Studio: social post ideas (tips / quotes / promos) ────────────────
// Editorial brand-voice copy used by the code-driven social templates and the
// daily post planner. Fully trilingual so every generated post is publish-ready
// in fa / ps / en. Managed from the admin panel (Content group).
model SocialIdea {
  id        String   @id @default(cuid())
  kind      String // tip | quote | promo
  text      String // canonical text (en)
  textI18n  Json? // { en, fa, ps }
  note      String? // optional secondary line (attribution / context)
  noteI18n  Json?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, active])
}

// ─── Automation: social auto-publish + pipeline (R26) ─────────────────────────
model PublishChannel {
  id              String    @id @default(cuid())
  platform        String    @unique // telegram | facebook | instagram | x
  label           String
  enabled         Boolean   @default(false)
  credentials     Json? // { botToken, chatId } / { pageId, accessToken } …
  lastStatus      String? // ok | error | not_configured
  lastError       String?
  lastPublishedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deliveries      SocialDelivery[]
}

model SocialPostQueue {
  id            String    @id @default(cuid())
  scheduledFor  DateTime // posting slot (AFT business hours)
  templateType  String // spotlight | deadline | tip | quote | promo | news | stat | story
  contentRef    String? // slug / id of the source content
  contentJson   Json // full content snapshot for deterministic rendering
  captionJson   Json // { en, fa, ps }
  imageStatus   String    @default("none") // none | ready | failed
  renderAttempts Int     @default(0)
  nextRenderAttemptAt DateTime?
  imagePaths    Json? // { square?, portrait? } → /generated-posts/*.png
  status        String    @default("pending") // pending | rendering | ready | publishing | published | partial | failed | cancelled
  results       Json? // per-channel { platform: { ok, error?, downgraded? } }
  externalIds   Json? // per-channel { platform: { id, permalink? } } — for dedupe/reconciliation
  attempts      Int       @default(0)
  error         String?
  publishedAt   DateTime?
  claimedAt     DateTime? // set when a worker claims the row (publishing/rendering)
  notifiedAt    DateTime? // admin failure alert sent
  requiresManualPublish Boolean @default(false) // Brand Studio publish-now rows are never worker-owned
  facebookGroupDistribution Boolean @default(false)
  facebookGroupMode         String  @default("auto") // auto | manual
  facebookGroupCampaigns    FacebookGroupCampaign[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deliveries    SocialDelivery[]

  @@unique([contentRef, scheduledFor]) // a post can never be double-queued for a slot
  @@index([scheduledFor, status])
  @@index([status])
}

model SocialDelivery {
  id            String         @id @default(cuid())
  queueId       String
  channelId     String
  platform      String
  status        String         @default("pending") // pending | publishing | published | retry_wait | failed | blocked | cancelled
  attempts      Int            @default(0)
  nextAttemptAt DateTime?
  lastAttemptAt DateTime?
  errorCode     String?
  error         String?
  externalId    String?
  permalink     String?
  publishedAt   DateTime?
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  queue         SocialPostQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  channel       PublishChannel  @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@unique([queueId, channelId])
  @@index([queueId])
  @@index([platform, status])
  @@index([status, nextAttemptAt])
}

model StudioDesign {
  id            String   @id @default(cuid())
  contentRef    String // slug / id of the source content
  forDate       String // YYYY-MM-DD plan date the design applies to
  templateType  String
  themeId       String   @default("midnight")
  layout        String   @default("classic")
  size          String   @default("square")
  overrides     Json? // { title?, note?, items?, statValue?, statLabel?, personName?, personMeta?, deadlineDate? }
  captionOverride Json? // { fa?, ps?, en? } — manual caption text per language
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([contentRef, forDate])
  @@index([forDate])
}

model PipelineRun {
  id         String    @id @default(cuid())
  kind       String // tick | import | translate | publish
  status     String    @default("running") // running | ok | partial | error
  stats      Json?
  message    String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([kind, startedAt])
}

// Single-row automation state (cursors + backoff), kept out of SiteSetting for clarity.
model AutomationState {
  id        String   @id @default("singleton")
  state     Json     @default("{}") // { translateBackoffUntil, lastQueueBuildDate, … }
  updatedAt DateTime @updatedAt
}

// ─── Facebook Group Distribution ──────────────────────────────────────────────
// Meta removed the public Groups API in April 2024. These models intentionally
// keep destination management/queueing independent from the transport so an
// official transport can replace today's manual-assist path without changing
// ARIA HUB content, scheduling, matching, or history.
model FacebookGroup {
  id                         String   @id @default(cuid())
  name                       String
  groupId                    String?  @unique
  url                        String   @unique
  language                   String? // fa | ps | en | any
  audience                   String?
  region                     String?
  active                     Boolean  @default(true)
  postingEligible            Boolean  @default(true)
  approvalRequired           Boolean  @default(false)
  notes                      String?  @db.Text
  lastSuccessfulDistribution DateTime?
  lastFailure                DateTime?
  lastError                  String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  tagLinks                   FacebookGroupTagLink[]
  jobs                       FacebookGroupDistributionJob[]

  @@index([active, postingEligible])
  @@index([language, region])
}

model FacebookGroupTag {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  createdAt  DateTime @default(now())
  groupLinks FacebookGroupTagLink[]
}

model FacebookGroupTagLink {
  groupId String
  tagId   String
  group   FacebookGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tag     FacebookGroupTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([groupId, tagId])
  @@index([tagId])
}

model FacebookGroupDistributionRule {
  id                   String   @id @default(cuid())
  name                 String
  enabled              Boolean  @default(true)
  contentKinds         String[] @default([])
  contentCategories    String[] @default([])
  includeTags          String[] @default([])
  excludeTags          String[] @default([])
  languages            String[] @default([])
  regions              String[] @default([])
  includeGroupIds      String[] @default([])
  excludeGroupIds      String[] @default([])
  requireLanguageMatch Boolean  @default(false)
  requireRegionMatch   Boolean  @default(false)
  priority             Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([enabled, priority])
}

model FacebookGroupCampaign {
  id               String   @id @default(cuid())
  sourceQueueId    String?
  sourceQueue      SocialPostQueue? @relation(fields: [sourceQueueId], references: [id], onDelete: SetNull)
  sourceContentRef String?
  selectionMode    String   @default("auto") // auto | manual
  transport        String   @default("manual_assist")
  status           String   @default("requires_review")
  scheduledFor     DateTime?
  autoSourceKey    String?  @unique
  createdByAdminId String?
  summary          Json?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  jobs             FacebookGroupDistributionJob[]

  @@index([status, createdAt])
  @@index([sourceQueueId])
}

model FacebookGroupDistributionJob {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        FacebookGroupCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  groupId         String
  group           FacebookGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  sourceQueueId   String
  status          String   @default("requires_review") // pending | queued | processing | completed | failed | cancelled | paused | requires_review | approval_required
  transport       String   @default("manual_assist")
  scheduledFor    DateTime?
  attemptCount    Int      @default(0)
  lastAttemptAt   DateTime?
  nextAttemptAt   DateTime?
  matchReasons    Json     @default("[]")
  errorType       String?
  errorMessage    String?
  retryable       Boolean?
  suggestedAction String?
  externalReference String?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([campaignId, groupId])
  @@unique([sourceQueueId, groupId])
  @@index([status, scheduledFor])
  @@index([groupId, createdAt])
}

// ─── Static Pages (CMS) ────────────────────────────────────────────────────────
model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  titleI18n       Json?
  content         String   @db.Text
  contentI18n     Json?
  status          String   @default("published")
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


/// Reusable branded visuals (statues, scientists, flags, landmarks…) that the
/// Brand Studio can layer behind posters. Admin-managed via /api/admin/studio/visuals.
model StudioVisual {
  id        String   @id @default(cuid())
  label     String
  category  String   @default("general")
  url       String
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
