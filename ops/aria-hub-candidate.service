[Unit]
Description=ARIA HUB Candidate Release (latest-test review) — final HEAD
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ariahub
Group=ariahub
WorkingDirectory=/opt/aria-hub/releases/20261005-7491d33
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/etc/aria-hub/web.env
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
MemoryMax=2048M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/aria-hub

[Install]
WantedBy=multi-user.target
