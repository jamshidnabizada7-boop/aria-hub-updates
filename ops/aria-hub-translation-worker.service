[Unit]
Description=ARIA HUB Opportunity Translation Worker (Persian-first, Pashto-second)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ariahub
WorkingDirectory=/opt/aria-hub
Environment=NODE_ENV=production
Environment=WORKER_ALLOW_REMOTE=1
EnvironmentFile=-/etc/aria-hub/translation-worker.env
ExecStart=/usr/local/bin/bun --conditions=react-server scripts/opportunity-translation-worker.ts
Restart=always
RestartSec=10
MemoryMax=512M
Nice=5

[Install]
WantedBy=multi-user.target
